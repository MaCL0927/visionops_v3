VISIONOPS_VENV=/opt/visionops_v3/venv
VISIONOPS_CARTON_BUNDLE_GRASP_CONFIG=/etc/visionops_v3/carton_bundle_grasp.yaml
VISIONOPS_CAMERA_SELECTION_FILE=/opt/visionops_v3/configs/runtime/generated/active_camera.json

# Optional Runtime binary override.
# VISIONOPS_RUNTIME_BIN=/opt/visionops_v3/build-rknn/edge/runtime_cpp/visionops_runtime_mock

# REQUIRED before production inference: point to the deployed segmentation package
# containing model.rknn + model.yaml.
VISIONOPS_CARTON_BUNDLE_GRASP_MODEL_DIR=/opt/visionops_v3/models/carton_bundle_grasp/current

# One RKNN context; worker=1 remains the validated stable Runtime setting.
VISIONOPS_RUNTIME_HTTP_WORKERS=1

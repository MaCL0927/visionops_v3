[Unit]
Description=VisionOps v3 M41.2 Carton Bundle Grasp Collector Web
After=network-online.target visionops-v3-carton-bundle-grasp-runtime.service visionops-v3-carton-bundle-grasp-app.service
Wants=network-online.target visionops-v3-carton-bundle-grasp-runtime.service visionops-v3-carton-bundle-grasp-app.service

[Service]
Type=simple
WorkingDirectory=/opt/visionops_v3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/visionops_v3/carton_bundle_grasp.env
ExecStart=/opt/visionops_v3/production/carton_bundle_grasp/scripts/start_collector.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

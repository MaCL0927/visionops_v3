[Unit]
Description=VisionOps v3 M41.2 Carton Bundle Grasp App
After=network-online.target visionops-v3-carton-bundle-grasp-runtime.service visionops-orbbec336l-bridge.service
Wants=network-online.target visionops-v3-carton-bundle-grasp-runtime.service visionops-orbbec336l-bridge.service

[Service]
Type=simple
WorkingDirectory=/opt/visionops_v3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/visionops_v3/carton_bundle_grasp.env
ExecStart=/opt/visionops_v3/production/carton_bundle_grasp/scripts/start_app.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

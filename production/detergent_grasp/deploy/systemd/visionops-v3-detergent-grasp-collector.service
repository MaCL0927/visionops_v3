[Unit]
Description=VisionOps v3 Detergent Grasp Collector Web
After=network-online.target visionops-v3-detergent-grasp-runtime.service visionops-v3-detergent-grasp-app.service
Wants=network-online.target visionops-v3-detergent-grasp-runtime.service visionops-v3-detergent-grasp-app.service

[Service]
Type=simple
WorkingDirectory=/opt/visionops_v3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/visionops_v3/detergent_grasp.env
ExecStart=/opt/visionops_v3/production/detergent_grasp/scripts/start_collector.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

[Unit]
Description=VisionOps v3 Detergent Grasp WebSocket and HTTP App
After=network-online.target visionops-v3-detergent-grasp-runtime.service
Wants=network-online.target visionops-v3-detergent-grasp-runtime.service

[Service]
Type=simple
WorkingDirectory=/opt/visionops_v3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/visionops_v3/detergent_grasp.env
ExecStart=/opt/visionops_v3/production/detergent_grasp/scripts/start_app.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

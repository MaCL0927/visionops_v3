# M36.2: Orbbec 336L shared-RGB -> RKNN Runtime
VISIONOPS_EDGE_ROOT=/opt/visionops_v3
VISIONOPS_FOAM_RING_MODEL_DIR=/opt/visionops_v3/models/rk3576-001_ring_seg_20260729_100731
VISIONOPS_RUNTIME_PORT=28081
VISIONOPS_DEVICE_ID=lb3576-001

# Keep legacy_proto for the current real-time baseline.
# mask_decode_mode is configured in the model package model.yaml, not here.
VISIONOPS_FRAME_SOURCE=shared_memory
VISIONOPS_SHARED_MEMORY_NAME=/visionops_orbbec336l_rgb
VISIONOPS_SHARED_MEMORY_FALLBACK_HTTP=true
VISIONOPS_CAMERA_FPS=30
VISIONOPS_PREPROCESS_BACKEND=rga
VISIONOPS_STALE_FRAME_TIMEOUT_MS=3000
VISIONOPS_RECONNECT_FAILURE_THRESHOLD=3
VISIONOPS_RECONNECT_INITIAL_MS=200
VISIONOPS_RECONNECT_MAX_MS=2000

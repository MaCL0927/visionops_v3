VISIONOPS_VENV=/opt/visionops_v3/venv
VISIONOPS_PLASTIC_BAG_GRASP_CONFIG=/etc/visionops_v3/plastic_bag_grasp.yaml
VISIONOPS_CAMERA_SELECTION_FILE=/opt/visionops_v3/configs/runtime/generated/active_camera.json

# 生产 Runtime 二进制（按现场构建路径需要时覆盖）
# VISIONOPS_RUNTIME_BIN=/opt/visionops_v3/build-rknn/edge/runtime_cpp/visionops_runtime_mock

# 当前已验证的 plastic_bag detection 模型。
VISIONOPS_PLASTIC_BAG_GRASP_MODEL_DIR=/opt/visionops_v3/models/rk3576-252_plastic_bag_grasp_det_20260819_094048

# RKNN 单 context 推理本来就是串行的。当前平台上 HTTP worker=1 已验证可避免
# 多 worker 场景下的 Runtime 堆内存破坏，同时不会引入额外 5 Hz 推送限流。
VISIONOPS_RUNTIME_HTTP_WORKERS=1
